{
  "name": "fit-check",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/src/index.ts\" \"vite --config web/vite.config.ts\"",
    "server": "tsx server/src/index.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "npm run build && NODE_ENV=production tsx server/src/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:8787",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "phone": "tsx scripts/phone.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "tunnel:setup": "tsx scripts/tunnel-setup.ts",
    "service": "tsx scripts/service.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1175.0",
    "@aws-sdk/credential-providers": "^3.1175.0",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "description": "Phone-first wardrobe planner: digitize your clothes, try outfits on a photo of yourself, and find the cheapest purchases for a full work week.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
