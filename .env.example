# Copy to .env and fill in. Never commit .env.

# Password for the web app (you enter it once on your phone). Required if you expose the app with a tunnel.
APP_PASSWORD=change-me

# Google Gemini API key (https://aistudio.google.com/apikey). Used for studio images, outfit renders, tagging, scoring.
GEMINI_API_KEY=

# Optional: AWS credentials for Amazon Bedrock (removes the background from your photo; without AWS the photo is used as-is).
# Any standard AWS credential source works: a named profile (aws sso login --profile <name>), env keys, etc.
# Enable the Stability "Remove Background" model in the Bedrock console (us-east-1).
AWS_PROFILE=
AWS_REGION=us-east-1

# Steers garment studio images to the right cut, e.g. "men's" or "women's". Optional.
GARMENT_FIT=

# Optional: FASHN try-on via fal.ai (only used with TRYON_PROVIDER=fashn).
FAL_KEY=
# TRYON_PROVIDER=fashn

# Optional: permanent link on your own Cloudflare domain. Set these with: npm run tunnel:setup -- fitcheck.example.com
# TUNNEL_NAME=fitcheck
# PUBLIC_HOSTNAME=fitcheck.example.com

# Optional: where data and backups live. Defaults: ./data and ~/FitCheck-backups
# DATA_DIR=data
# BACKUP_DIR=~/FitCheck-backups

# Optional: run with fake AI output (no keys, no cost) to try the UI.
# MOCK_AI=1
